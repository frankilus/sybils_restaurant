/* Live open/closed — America/New_York, flagship hours */
function checkStatus(){
  try{
    var now=new Date();
    var parts=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(now);
    var wd='',h=0,m=0;
    parts.forEach(function(p){ if(p.type==='weekday') wd=p.value; if(p.type==='hour') h=parseInt(p.value,10)%24; if(p.type==='minute') m=parseInt(p.value,10); });
    var dayMap={Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6}; var day=dayMap[wd];
    var mins=h*60+m; var open=6*60+30; var close=(day===5||day===6)?23*60+30:22*60;
    var isOpen=mins>=open&&mins<close;
    var dot=document.getElementById('statusDot'); var txt=document.getElementById('statusText'); var det=document.getElementById('statusDetail');
    var live=document.getElementById('hoursLive'); var slipH=document.getElementById('slipHours');
    var closeLabel=(day===5||day===6)?'11:30 PM':'10:00 PM';
    if(slipH) slipH.textContent='6:30 AM \u2013 '+closeLabel;
    if(isOpen){ dot.classList.remove('closed'); txt.textContent='Open now'; det.textContent=' \u00B7 until '+closeLabel; if(live) live.textContent='\uD83D\uDFE2 Open now \u2014 until '+closeLabel+' tonight.'; }
